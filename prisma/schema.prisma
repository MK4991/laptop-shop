
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  brand_id   BigInt   @id @default(autoincrement())
  brand_name String   @unique @db.VarChar(50)

  laptops    Laptop[]

  @@map("brand")
}

model Laptop {
  laptop_id             BigInt   @id @default(autoincrement())
  brand_id              BigInt
  model                 String   @db.VarChar(100)
  processor_brand       String   @db.VarChar(30)
  processor_model       String   @db.VarChar(100)
  processor_generation  Int?
  ram_capacity          Int
  storage_capacity      Int
  storage_type          String   @db.VarChar(30)
  price                 Decimal  @db.Decimal(15, 2)
  condition             String   @db.VarChar(20)
  graphics_card         String   @db.VarChar(100)
  screen_size           Decimal  @db.Decimal(4, 1)
  quantity              Int      @default(0)
  availability          String   @default("Available") @db.VarChar(20)

  brand                 Brand   @relation(fields: [brand_id], references: [brand_id])
  images                LaptopImage[]

    // Prevent duplicate laptop configurations
  @@unique([brand_id, model, processor_brand, processor_model, processor_generation, ram_capacity, storage_capacity, storage_type, condition, graphics_card, screen_size], map: "laptop_configuration_unique")
  @@map("laptop")
}

model LaptopImage {
  image_id     BigInt   @id @default(autoincrement())
  laptop_id    BigInt
  image_url    String   @db.VarChar(255)
  is_primary   Boolean  @default(false)

  laptop       Laptop   @relation(fields: [laptop_id], references: [laptop_id], onDelete: Cascade)

  @@map("laptop_image")
}

model Administrator {
  admin_id      BigInt   @id @default(autoincrement())
  username      String   @unique @db.VarChar(50)
  email         String   @unique @db.VarChar(100)
  password_hash String   @db.VarChar(255)

  @@map("administrator")
}

model AdminSession {
  sid        String   @id @db.VarChar(255)
  data       Json
  expires_at DateTime @db.Timestamptz(3)

  @@index([expires_at])
  @@map("admin_session")
}
